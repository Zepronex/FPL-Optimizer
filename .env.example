# Local PostgreSQL configuration for Docker Compose and API database scripts
POSTGRES_DB=scoutiq
POSTGRES_USER=scoutiq
POSTGRES_PASSWORD=scoutiq
POSTGRES_PORT=5432

# API database connection
DATABASE_URL=postgresql://scoutiq:scoutiq@localhost:5432/scoutiq
DATABASE_SSL=false

# API explanation agent
SCOUTIQ_AGENT_ENABLED=false
SCOUTIQ_AGENT_PROVIDER=auto
SCOUTIQ_AGENT_TIMEOUT_MS=10000
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
