# ScoutIQ local environment template. Copy to .env and replace required blanks.
# Never place real values in this tracked example.

# Runtime (non-secret server configuration)
NODE_ENV=development
PORT=3001
# Local default is loopback. Production platforms commonly require 0.0.0.0.
API_BIND_ADDRESS=127.0.0.1
SCOUTIQ_APP_VERSION=local
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Client IP handling. Keep false unless the API is behind a known proxy. In
# production, use exact trusted proxy IPs or canonical, deployment-owned CIDRs
# (IPv4 /16+, IPv6 /32+, mapped IPv4 /112+), comma-separated.
TRUST_PROXY=false

# Per-client in-memory API rate limits (15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_EXPENSIVE_MAX=20

# Request parsing limits
JSON_BODY_LIMIT_BYTES=65536
URLENCODED_BODY_LIMIT_BYTES=16384
MAX_QUERY_PARAMETERS=20
MAX_URL_LENGTH=2048

# PostgreSQL. POSTGRES_PASSWORD is required locally when DATABASE_URL is blank.
# DATABASE_URL is a server-only secret and is normally supplied by the deployment
# secret store in production. Do not put a connection string in this file.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scoutiq
POSTGRES_USER=scoutiq
POSTGRES_PASSWORD=
DATABASE_URL=
# Production requires both TLS settings to remain true. Local PostgreSQL may use false.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=30000
POSTGRES_BIND_ADDRESS=127.0.0.1

# Public FPL ingestion metadata (non-secret)
FPL_SEASON=

# Optional explanation provider. Keys are server-only secrets. Leave the agent
# disabled for deterministic local fallback, or inject real keys from a secret store.
SCOUTIQ_AGENT_ENABLED=false
SCOUTIQ_AGENT_PROVIDER=auto
SCOUTIQ_AGENT_TIMEOUT_MS=10000
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Local smoke-test targets (non-secret; never embed credentials in these URLs)
SCOUTIQ_API_URL=http://localhost:3001
SCOUTIQ_WEB_URL=http://localhost:3000
SCOUTIQ_SMOKE_TIMEOUT_MS=5000

# Optional local interpreter override; otherwise .venv/python/python3 is detected.
PYTHON=
