# API service configuration
PORT=3001
NODE_ENV=development

# Browser clients allowed by CORS
FRONTEND_URL=http://localhost:3000

# External services
FPL_API_BASE_URL=https://fantasy.premierleague.com/api
ML_SERVICE_URL=http://localhost:3002

# Explanation agent
SCOUTIQ_AGENT_ENABLED=false
SCOUTIQ_AGENT_PROVIDER=auto
SCOUTIQ_AGENT_TIMEOUT_MS=10000
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scoutiq
POSTGRES_USER=scoutiq
POSTGRES_PASSWORD=scoutiq
DATABASE_URL=postgresql://scoutiq:scoutiq@localhost:5432/scoutiq
DATABASE_SSL=false

# Operational defaults
CACHE_TTL_SECONDS=3600
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_STRICT_MAX=10
REQUEST_SIZE_LIMIT=10mb
LOG_LEVEL=info
