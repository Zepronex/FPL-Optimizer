{
  "name": "fpl-optimizer",
  "version": "1.0.0",
  "description": "Fantasy Premier League team optimization tool",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter @fpl-optimizer/api run dev\" \"pnpm --filter @fpl-optimizer/web run dev\" \"pnpm --filter @fpl-optimizer/ml run dev\"",
    "dev:api": "pnpm --filter @fpl-optimizer/api run dev",
    "dev:web": "pnpm --filter @fpl-optimizer/web run dev",
    "dev:ml": "pnpm --filter @fpl-optimizer/ml run dev",
    "build": "pnpm --filter @fpl-optimizer/api --filter @fpl-optimizer/web run build",
    "build:api": "pnpm --filter @fpl-optimizer/api run build",
    "build:web": "pnpm --filter @fpl-optimizer/web run build",
    "ingest:fpl": "pnpm --filter @fpl-optimizer/api run ingest:fpl",
    "ingest:fpl:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/ingest-fpl.ps1",
    "test:api": "pnpm --filter @fpl-optimizer/api run test",
    "install:all": "pnpm install",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['node_modules','apps/api/node_modules','apps/web/node_modules','apps/ml/node_modules','apps/api/dist','apps/web/dist','apps/web/.vite']) fs.rmSync(p,{recursive:true,force:true});\"",
    "train:ml": "pnpm --filter @fpl-optimizer/ml run train",
    "predict:ml": "pnpm --filter @fpl-optimizer/ml run predict"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

